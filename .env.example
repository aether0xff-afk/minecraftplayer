# White PC: your existing 26.3 Minecraft server + ViaProxy + headless bot.
# KEEP ViaProxy at the SAME address and account index you previously tested.
MC_HOST=127.0.0.1
MC_PORT=25568
MC_VERSION=26.1
MC_LOCAL_NAME=WildPlayer
# Real in-game sub-account nickname; used to ignore own chat and logs
MC_REAL_NAME=

# SAFETY: first launch in observation-only mode; enable settings in console after checking.
# For unattended live play, set AUTONOMY=true, ALLOW_MOVEMENT=true, ALLOW_DIG=true,
# ALLOW_CRAFT=true and ALLOW_PLACE_TABLE=true after making a world backup.
AUTONOMY=false
ALLOW_MOVEMENT=false
ALLOW_DIG=false
ALLOW_CRAFT=false
ALLOW_PLACE_TABLE=false
ALLOW_ATTACK=false
# Multiplayer PvP always requires BOTH explicit enable AND target allowlist.
ALLOW_PVP=false
PVP_ALLOWED_PLAYERS=
OWNER_NAMES=

# Choose qwen3.5:4b for faster responses or qwen3.5:9b for stronger reasoning.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_CONTEXT=4096
# relaxed = unhurried / natural = balanced (default) / focused = more active
PLAY_TEMPO=natural
# Replans are triggered by events and a jittered background cadence; no fixed 10s timer.
LLM_TIMEOUT_MS=45000
CHAT_COOLDOWN_MS=8000
CRITICAL_HEALTH=8
MIN_COMBAT_HEALTH=9

# Experimental viewer. 26.3 rendering is NOT guaranteed.
VIEWER_PORT=3007
VIEWER_DISTANCE=4

# v0.4 motor layer is opt-in and will not modify autonomous behavior unless enabled.
# Console: movement on -> motor on -> motor frame <JSON> -> motor off
MOTOR_FRAME_TTL_MS=5000
